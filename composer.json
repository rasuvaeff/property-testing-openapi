{
    "name": "rasuvaeff/property-testing-openapi",
    "description": "OpenAPI request-case generators and PSR-7 materialization for rasuvaeff/property-testing",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "contract-testing",
        "openapi",
        "property-testing",
        "psr-7"
    ],
    "authors": [
        {
            "name": "Victor Razuvaev",
            "email": "rasuvaeff@gmail.com"
        }
    ],
    "homepage": "https://github.com/rasuvaeff/property-testing-openapi",
    "support": {
        "issues": "https://github.com/rasuvaeff/property-testing-openapi/issues",
        "source": "https://github.com/rasuvaeff/property-testing-openapi"
    },
    "require": {
        "php": "8.3 - 8.5",
        "ext-mbstring": "*",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "rasuvaeff/openapi-contract": "^0.6",
        "rasuvaeff/property-testing-core": "^0.5 || ^0.6"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.51",
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.35",
        "league/openapi-psr7-validator": "^0.24",
        "maglnet/composer-require-checker": "^4.17",
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^11.5 || ^12 || ^13",
        "predis/predis": "^2.2 || ^3.0",
        "rasuvaeff/property-testing-testo": "^0.7",
        "rasuvaeff/rector-named-literals": "^1.0",
        "rasuvaeff/understudy-testo": "^0.2",
        "rector/rector": "^2.4",
        "roave/backward-compatibility-check": "^8.0",
        "testo/bridge-infection": "^0.1.6",
        "testo/testo": "^0.10.39",
        "vimeo/psalm": "^6.16"
    },
    "suggest": {
        "ext-redis": "Required for PROPERTY_DB=redis://... shared regression corpora",
        "predis/predis": "Required for PROPERTY_DB=redis://... when ext-redis is unavailable"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Rasuvaeff\\PropertyTesting\\OpenApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rasuvaeff\\PropertyTesting\\OpenApi\\Benchmarks\\": "benchmarks/",
            "Rasuvaeff\\PropertyTesting\\OpenApi\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true
        },
        "platform": {
            "ext-bcmath": "1.0.0",
            "ext-intl": "1.0.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "bc-check": "roave-backward-compatibility-check",
        "bench": "testo --suite=Benchmarks -vv",
        "build": [
            "@composer validate --strict",
            "@composer normalize --dry-run",
            "@require-checker",
            "@cs",
            "@psalm",
            "@test",
            "@test:phpunit"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.php",
        "cs:fix": "php-cs-fixer fix --diff --config=.php-cs-fixer.php",
        "mutation": "infection --threads=max",
        "psalm": "psalm --no-cache",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "release-check": [
            "@build",
            "@rector",
            "@bc-check"
        ],
        "require-checker": "composer-require-checker check composer.json --config-file=composer-require-checker.json",
        "test": "testo --suite=Unit",
        "test:coverage": "testo --suite=Unit --coverage --coverage-clover=build/coverage.xml",
        "test:coverage:ci": "testo --suite=Unit --coverage-clover=build/coverage.xml",
        "test:phpunit": "phpunit -c phpunit.xml"
    }
}
